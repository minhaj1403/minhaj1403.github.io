---
---
<!-- _layouts/teaching_bib.liquid: one compact row per course -->
{% assign title_parts = entry.title | split: ": " %}
{% if title_parts.size > 1 %}
  {% assign course_code = title_parts[0] %}
  {% assign course_name = entry.title | remove_first: course_code | remove_first: ": " %}
{% else %}
  {% assign course_code = "" %}
  {% assign course_name = entry.title %}
{% endif %}
{% assign plain_roles = "Teaching Assistant,Course Instructor" | split: "," %}

<div id="{{ entry.key }}" class="course">
  <div class="course-main">
    {% if course_code != "" %}<span class="course-code">{{ course_code }}</span>{% endif %}
    <span class="course-name">{{ course_name }}</span>
  </div>
  {% if entry.duration %}<div class="course-term">{{ entry.duration }}</div>{% endif %}
  <div class="course-meta">
    {%- if entry.role and plain_roles contains entry.role -%}
      {{ entry.institution }}
    {%- else -%}
      {{ entry.role }}{% if entry.role and entry.institution %}<span class="sep">·</span>{% endif %}{{ entry.institution }}
    {%- endif -%}
  </div>
</div>
