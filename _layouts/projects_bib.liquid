---
---
<article id="{{ entry.key }}" class="project-item">
  {% if site.enable_project_thumbnails and entry.preview %}
    <div class="project-thumb">
      {% if entry.preview contains '://' %}
        <img src="{{ entry.preview }}" alt="{{ entry.title }}" loading="lazy">
      {% else %}
        {% assign entry_path = entry.preview | prepend: '/assets/img/project_preview/' %}
        {%
          include figure.liquid
          loading="lazy"
          path=entry_path
          sizes="(min-width: 576px) 220px, 100vw"
          zoomable=true
          avoid_scaling=true
          alt=entry.title
        %}
      {% endif %}
    </div>
  {% endif %}

  <div class="project-body">
    <div class="project-head">
      <h3 class="project-title">{{ entry.title }}</h3>
      {% if entry.duration %}<span class="project-date">{{ entry.duration }}</span>{% endif %}
    </div>

    <p class="project-desc">{{ entry.description }}</p>

    {% if entry.keywords %}
      <ul class="project-tags">
        {% assign keywords_array = entry.keywords | split: "," %}
        {% for keyword in keywords_array %}
          <li>{{ keyword | strip }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if entry.website != blank or entry.code != blank or entry.report != blank %}
      <div class="project-links">
        {% if entry.website != blank %}
          <a href="{{ entry.website }}" class="project-link" target="_blank" rel="noopener"><i class="fa-solid fa-globe"></i> Website</a>
        {% endif %}
        {% if entry.code != blank %}
          <a href="{{ entry.code }}" class="project-link" target="_blank" rel="noopener"><i class="fa-solid fa-code"></i> Code</a>
        {% endif %}
        {% if entry.report != blank %}
          <a href="{{ entry.report }}" class="project-link" target="_blank" rel="noopener"><i class="fa-solid fa-file-lines"></i> Report</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</article>
